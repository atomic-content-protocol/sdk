# --- AI providers (at least one required) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Model tier: fast (default: Haiku 4.5 / GPT-5.6 Luna) | balanced | best
ENRICHMENT_QUALITY=fast

# --- HTTP ---
PORT=3000
# Hops of reverse proxy in front of the server (Railway/Vercel = 1). "true"/"false" also accepted.
TRUST_PROXY=1
# Browser origins allowed to call /mcp (comma-separated). Empty = no browser origins.
CORS_ORIGINS=

# --- Abuse controls ---
# Weighted units per hour per client. A batch of N items costs N units.
# Enforced in memory, so this is PER INSTANCE: with N replicas the real limit
# is N x this. Count replicas by probing /health and counting distinct
# `instance` values. Run one replica for exact limits.
RATE_LIMIT_PER_HOUR=50
# Optional bearer tokens (comma-separated). When set, /mcp requires Authorization: Bearer <key>.
MCP_API_KEYS=
# Optional hard cap on estimated USD spend per UTC day, across ALL clients.
# Once reached every caller gets BUDGET_EXCEEDED until 00:00 UTC, so set it to
# the most you are willing to lose in a day, not to expected usage.
# Scale: one enrichment costs ~$0.003 on the default `fast` tier, and one client
# saturating RATE_LIMIT_PER_HOUR=50 for 24h spends ~$3.60.
# Also enforced per instance: with N replicas the real ceiling is N x this.
#   5   ≈ 1,650 enrichments/day  (recommended for a public demo server)
#   25  ≈ 8,300 enrichments/day  (launch headroom)
#   unset = no cap (rate limiting is then the only control)
DAILY_COST_CAP_USD=5
# Max characters per content item.
MAX_CONTENT_LENGTH=50000
ENRICHMENT_TIMEOUT_MS=25000

# --- PostHog analytics (optional) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
